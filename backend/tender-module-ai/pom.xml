<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.tenderintelligence</groupId>
        <artifactId>tender</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>tender-module-ai</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        ai 包下，大模型语义模糊查找（M4）
        口语化查询 → LLM 查询理解 → 向量 + BM25 + 结构化过滤 三路召回 → Rerank → 评测
        读公告一律走 tender-module-notice 暴露的 NoticeApi，不直接连 notice 表
    </description>

    <dependencies>
        <!-- 业务模块：读公告走 NoticeApi（契约见 doc/毕设 §5） -->
        <dependency>
            <groupId>com.tenderintelligence</groupId>
            <artifactId>tender-module-notice</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- LLM 统一客户端（配置、重试、限流、响应缓存） -->
        <dependency>
            <groupId>com.tenderintelligence</groupId>
            <artifactId>tender-spring-boot-starter-ai</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.tenderintelligence</groupId>
            <artifactId>tender-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tenderintelligence</groupId>
            <artifactId>tender-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.tenderintelligence</groupId>
            <artifactId>tender-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.tenderintelligence</groupId>
            <artifactId>tender-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
