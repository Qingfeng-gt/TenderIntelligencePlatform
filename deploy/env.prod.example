# 生产环境变量模板
# 复制到 /etc/tender/tender.env，chmod 600，按实际环境填写。
# 不要把真实值提交到仓库。

SPRING_PROFILES_ACTIVE=prod

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tender
DB_USERNAME=tender
DB_PASSWORD=change-me
DB_SSL=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me

# AI（不使用可留空）
DEEPSEEK_API_KEY=
AI_ENABLED=false

# 采集调度（多实例时只在一个实例设为 true）
CRAWLER_SCHEDULE_ENABLED=true
CRAWLER_SCHEDULE_CRON=0 0 */2 * * ?

# 日志目录
LOG_PATH=/var/log/tender

# 管理端 UI 地址（用于 Swagger / 邮件等场景）
ADMIN_UI_URL=https://admin.example.com
