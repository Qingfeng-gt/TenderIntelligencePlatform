  NOTICE ||--o{ NOTICE_CHANGE : "澄清/变更"
  NOTICE ||--o{ NOTICE_ENTERPRISE : "关联企业"
  ENTERPRISE ||--o{ NOTICE_ENTERPRISE : "参与"
  ENTERPRISE ||--o{ ENTERPRISE_ROLE : "角色"
  ENTERPRISE ||--o{ ENTERPRISE_CONTACT : "联系人"
  ENTERPRISE ||--o{ ENTERPRISE_ALIAS : "别名"
  ENTERPRISE ||--o{ PROJECT : "招标人/代理"
  CRAWLER_SITE ||--o{ CRAWLER_CHANNEL : "频道配置"
  CRAWLER_SITE ||--o{ CRAWLER_TASK : "采集任务"
  CRAWLER_TASK ||--o{ CRAWLER_FETCH_LOG : "逐 URL 日志"
  CRAWLER_TASK ||--o{ CRAWL_RAW : "原始快照"
