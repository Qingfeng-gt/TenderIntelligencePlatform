<mxCell id="c3-e3" edge="1" parent="1" source="c3-auth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#475569;fontSize=11;labelBackgroundColor=#ffffff;" target="c3-ctrl" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c3-e4" edge="1" parent="1" source="c3-ctrl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#475569;fontSize=11;labelBackgroundColor=#ffffff;" target="c3-result" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="panel-a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#334155;" value="&lt;b&gt;URL 前缀规则（由包路径决定）&lt;/b&gt;" vertex="1"><mxGeometry height="190" width="460" x="40" y="760" as="geometry"/></mxCell><mxCell id="panel-a-body" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacingLeft=6;" value="• &lt;b&gt;controller.admin.**&lt;/b&gt; → /admin-api&lt;br&gt;• &lt;b&gt;controller.app.**&lt;/b&gt; → /app-api&lt;br&gt;• 其它包 → 无前缀（需手写全路径）&lt;br&gt;• 配置类：WebProperties&lt;br&gt;• yaml 未覆盖 tender.web.*.prefix，取默认值" vertex="1"><mxGeometry height="140" width="430" x="55" y="800" as="geometry"/></mxCell><mxCell id="panel-b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#334155;" value="&lt;b&gt;匿名放行机制&lt;/b&gt;" vertex="1"><mxGeometry height="190" width="460" x="520" y="760" as="geometry"/></mxCell><mxCell id="panel-b-body" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacingLeft=6;" value="① 启动扫描 &lt;b&gt;@PermitAll&lt;/b&gt;（方法级 / 类级）&lt;br&gt;② tender.security.permit-all-urls&lt;br&gt;　　当前：/admin-api/notice/**&lt;br&gt;　　　　　/app-api/ai-search/**&lt;br&gt;　　　　　/app-api/tag/**&lt;br&gt;③ 兜底 anyRequest().authenticated()" vertex="1"><mxGeometry height="140" width="430" x="535" y="800" as="geometry"/></mxCell><mxCell id="panel-c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#334155;" value="&lt;b&gt;常见 401 / 403 排查&lt;/b&gt;" vertex="1"><mxGeometry height="190" width="460" x="1000" y="760" as="geometry"/></mxCell><mxCell id="panel-c-body" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacingLeft=6;" value="• 登录后 403：会员令牌打了 /admin-api&lt;br&gt;• 接口 404：Controller 不在 controller.admin / app 包&lt;br&gt;• 采集接口 401：2026-09-11 起需管理员令牌&lt;br&gt;• 跨域：后端 CorsFilter 放行；&lt;br&gt;　admin-web 的 Vite 代理已注释，请求直连 48080" vertex="1"><mxGeometry height="140" width="430" x="1015" y="800" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>